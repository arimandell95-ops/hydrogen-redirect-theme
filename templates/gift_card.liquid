{% comment %}
  Gift cards are not available through the Storefront API, so this page must be
  served by the Online Store rather than the Hydrogen storefront. `layout none`
  bypasses theme.liquid entirely, which is what keeps it out of the redirect.
{% endcomment %}
{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <title>{{ shop.name }} gift card</title>
    <meta name="description" content="Your gift card">
    {{ content_for_header }}
    {{ 'template-giftcard.css' | asset_url | stylesheet_tag }}
  </head>
  <body>
    <main class="giftcard">
      <h1>{{ shop.name }}</h1>
      <p>Here is your gift card.</p>

      <p class="giftcard__value">{{ gift_card.initial_value | money }}</p>

      {%- if gift_card.balance != gift_card.initial_value -%}
        <p>Remaining balance: {{ gift_card.balance | money }}</p>
      {%- endif -%}

      <p>
        Gift card code:
        <strong><code>{{ gift_card.code | format_code }}</code></strong>
      </p>

      {%- if gift_card.expired and gift_card.enabled -%}
        <p>Expired on {{ gift_card.expires_on | date: '%d/%m/%Y' }}</p>
      {%- elsif gift_card.expires_on and gift_card.enabled -%}
        <p>Expires on {{ gift_card.expires_on | date: '%d/%m/%Y' }}</p>
      {%- endif -%}

      {%- unless gift_card.enabled -%}
        <p>This gift card is disabled.</p>
      {%- endunless -%}

      <p>
        <a href="https://{{ settings.storefront_hostname | default: shop.domain }}">
          Start shopping
        </a>
      </p>
    </main>
  </body>
</html>
